# ChromaDB persistence directory (default: backend/chroma_data). STORE=csv uses the in-memory store.
CHROMA_PATH=
STORE=chroma
# hashing (offline, default) or minilm (downloads all-MiniLM-L6-v2 on first run)
EMBEDDING_MODEL=hashing
# Optional. Unset -> deterministic template extractor/narrator only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Only needed if the frontend is hosted on a different origin
CORS_ORIGINS=http://localhost:5173
